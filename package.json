{
  "name": "dynskills",
  "version": "0.1.3",
  "description": "Experimental: Dynamic Skills, a just-in-time skill synthesizer for AI coding agents (Claude Code, Codex, OpenCode)",
  "keywords": [
    "agent-skills",
    "claude-code",
    "codex",
    "opencode",
    "ai-agents",
    "skills",
    "llm"
  ],
  "homepage": "https://github.com/prameet-verma/dynskills#readme",
  "bugs": {
    "url": "https://github.com/prameet-verma/dynskills/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prameet-verma/dynskills.git"
  },
  "license": "AGPL-3.0-only",
  "type": "module",
  "bin": {
    "dynskills": "dist/cli/index.js",
    "dynamic-skills": "dist/cli/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "schemas",
    "plugins",
    "NOTICE"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "node node_modules/typescript7/bin/tsc -p tsconfig.build.json",
    "typecheck": "node node_modules/typescript7/bin/tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "test:harness": "DS_HARNESS_E2E=claude vitest run test/harness",
    "bench": "pnpm build && node dist/cli/index.js benchmark",
    "install:local": "sh scripts/install-local.sh",
    "uninstall:local": "sh scripts/install-local.sh --uninstall",
    "prepublishOnly": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "version": "node scripts/sync-version.mjs && git add src/core/version.ts plugins skills"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "commander": "^15.1.0",
    "fast-glob": "^3.3.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.2",
    "typescript7": "npm:typescript@7.0.2",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.21.0"
}
